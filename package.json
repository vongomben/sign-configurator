{
  "name": "sign-configurator",
  "version": "0.1.0",
  "private": true,
  "description": "Configuratore insegne neon LED (browser)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:public": "tsc --noEmit && vite build --mode public",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && vite build && playwright test",
    "test:watch": "vitest",
    "predeploy": "npm run build:public",
    "deploy": "gh-pages -d dist --nojekyll"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vongomben/sign-configurator.git"
  },
  "homepage": "https://vongomben.github.io/sign-configurator/",
  "license": "ISC",
  "dependencies": {
    "comlink": "^4.4.2",
    "d3-delaunay": "^6.0.4",
    "manifold-3d": "^3.5.4",
    "marked": "^18.1.1",
    "opentype.js": "^2.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
